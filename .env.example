# Copy to .env and fill in the keys for the providers you use. Never commit .env.

# Claude API key. Leave blank to use your Claude subscription (run `claude login`).
ANTHROPIC_API_KEY=

# Other brains (brain_provider: openai_compatible)
DEEPSEEK_API_KEY=

# Paid voice and speech providers (only needed if selected in config.yaml)
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
